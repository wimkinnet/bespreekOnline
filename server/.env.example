# MongoDB connection string (MongoDB Atlas free tier works well with Render)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/consultcrm?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on (Render sets this automatically in production)
PORT=5001

# Comma-separated list of allowed origins for CORS when running client separately in dev
CLIENT_URL=http://localhost:5173

# Absolute or relative path where uploaded documents are stored.
# On Render, point this at your mounted persistent disk, e.g. /var/data/uploads
UPLOAD_DIR=./uploads

# Credentials used once by npm run seed to create the first admin account
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_password

# Travel costs: default EUR per km suggested when a time entry includes travel (round trip).
# The consultant can change the rate per time entry.
TRAVEL_RATE_PER_KM=0.45

# Contact identification sent to OpenStreetMap (Nominatim) when looking up addresses for distances.
# Their usage policy asks for a real contact; set this to your app name + email.
GEOCODER_USER_AGENT=bespreekOnline (katrien@bespreek.be)
